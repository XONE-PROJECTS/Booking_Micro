{
  "name": "@universal-booking/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "reset": "tsx src/scripts/reset.ts",
    "test": "vitest run",
    "test:unit": "vitest run --passWithNoTests test/unit"
  },
  "dependencies": {
    "@universal-booking/core": "*",
    "@universal-booking/workflow-engine": "*",
    "@universal-booking/booking-engine": "*",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11"
  }
}
