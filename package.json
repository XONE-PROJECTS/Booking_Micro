{
  "name": "universal-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Booking Microservice - industry-independent, API-first booking infrastructure.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test --concurrency=1",
    "test:unit": "turbo run test:unit",
    "test:e2e": "npm run test:e2e -w @universal-booking/e2e",
    "db:generate": "npm run generate -w @universal-booking/database",
    "db:migrate": "npm run migrate -w @universal-booking/database",
    "db:seed": "npm run seed -w @universal-booking/database",
    "db:reset": "npm run reset -w @universal-booking/database",
    "db:local": "node scripts/local-db.mjs",
    "openapi": "npm run openapi -w @universal-booking/api",
    "load-test": "node scripts/load-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "tsx": "^4.23.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
