# Copy to `.env` and set real values. Never commit `.env`.

NODE_ENV=development
DATABASE_URL=postgresql://booking:booking@127.0.0.1:54329/booking
JWT_SECRET=change-me-to-at-least-32-characters-long
ENCRYPTION_KEY=change-me-to-at-least-32-characters-long

APP_URL=http://localhost:6767
API_PREFIX=/api/v1
ADMIN_APP_URL=http://localhost:3000
PORTAL_APP_URL=http://localhost:3000

# Payment provider webhooks (verify signatures with provider secrets stored encrypted):
# POST {APP_URL}{API_PREFIX}/integrations/payments/webhooks/paymongo

JOBS_ENABLED=true
EMAIL_DRIVER=console
SMS_DRIVER=console
MIGRATE_ON_START=true